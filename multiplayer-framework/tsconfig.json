{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "platform/src",
    "contract/src",
    "games/*/src",
    "games/*/tests",
    "tests",
    "scripts",
    "vitest.config.ts",
    "games/*/web/vite.config.ts"
  ]
}
